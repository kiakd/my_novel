# ============================================================
#  Novel frontend (Next.js) — .env.local
#  คัดลอกเป็น .env.local:  cp .env.local.example .env.local
# ============================================================

# Backend เดิม (Bun/Elysia server.ts) ที่ Next จะ proxy /api และ /uploads ไปหา
# ต้องเป็น origin ของ server.ts (ตรงกับ PORT ใน novel/.env — ดีฟอลต์ 3000)
# Frontend นี้ไม่ต่อ MongoDB เอง — MongoDB ตั้งใน novel/.env เท่านั้น
BACKEND_URL=http://127.0.0.1:3000
