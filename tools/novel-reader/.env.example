# novel-reader — copy เป็น .env (ค่าใน env จริงของเครื่องชนะไฟล์นี้)

# บัญชีที่ใช้ AI ได้ — ตั้งคู่นี้แล้วจะใช้แทน auth.json
# NR_AUTH_USER=you@example.com
# NR_AUTH_PASS=เปลี่ยนเป็นรหัสยาวๆ
# หรือชี้ไฟล์บัญชีอื่น (ค่าเริ่มต้น auth.json ข้าง server.ts)
# NR_AUTH_FILE=auth.json

# กุญแจเซ็น session (ไม่ตั้ง = สุ่มเก็บใน library/.session-secret)
# NR_SESSION_SECRET=

# บน server หลัง reverse proxy (https)
# PORT=4000
# NR_HOST=127.0.0.1
# NR_TRUST_PROXY=1
# NR_COOKIE_SECURE=1

# DeepSeek (ถ้าไม่ตั้ง translate.ts อ่านจาก ../../novel/.env)
# DEEPSEEK_API_KEY=
