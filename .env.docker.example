# คัดลอกเป็น .env แล้วแก้ค่า → docker compose จะอ่านอัตโนมัติ
# (MONGODB_URI ถูกตั้งใน docker-compose ให้ชี้ไป service "mongo" แล้ว ไม่ต้องใส่ที่นี่)

MONGODB_DB=novel

# Image จาก CI (GHCR) — ปล่อย default ได้ (= ghcr.io/kiakd, latest)
# อยาก rollback ก็ปักเวอร์ชัน: TAG=<git-sha ของรอบที่ดี>
# REGISTRY=ghcr.io/kiakd
# TAG=latest

# DeepSeek (cloud provider) — ใส่คีย์ถ้าจะใช้ตอบแชทแบบ cloud
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Fireworks (ทางเลือก — เร็วกว่า official API ในหลายเคส)
# รองรับทั้ง FIREWORKS_API (ชื่อใน prod) และ FIREWORKS_API_KEY
FIREWORKS_API=
# FIREWORKS_API_KEY=
# สลับโมเดลแค่เปลี่ยนบรรทัดนี้ แล้ว: docker compose up -d --force-recreate novel
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p7-plus
# AI_PROVIDER=fireworks

# Cloudflare Tunnel — token จาก Zero Trust dashboard (ดู cloudflare-tunnel.md)
# ใส่แล้วรันด้วย: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- RAG embedding (ทางเลือก: ไม่ตั้ง = ใช้ FTS keyword อย่างเดียว) ---
# ⚠️ เนื้อหา R18: เลี่ยงผู้ให้บริการที่ moderate เข้ม (เช่น OpenAI อาจแบนบัญชี)
#    เลือกเจ้าที่อนุญาต mature content หรือ self-host embedding ก็ได้
EMBED_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=512
# path ไฟล์ sqlite ของ RAG (ใน container — map กับ volume ใน docker-compose)
MEM_DB_PATH=/data/chat-mem.sqlite
