# คัดลอกเป็น .env แล้วแก้ค่า → docker compose จะอ่านอัตโนมัติ
# (MONGODB_URI ถูกตั้งใน docker-compose ให้ชี้ไป service "mongo" แล้ว ไม่ต้องใส่ที่นี่)

MONGODB_DB=novel

# DeepSeek (cloud provider) — ใส่คีย์ถ้าจะใช้ตอบแชทแบบ cloud
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# LM Studio (Gemma local) — ค่า default ชี้ไป host.docker.internal:1234 (เครื่อง host)
# ถ้ารันบน cloud ที่ไม่มี LM Studio ปล่อยไว้ได้ แล้วใช้ DeepSeek แทน
LMSTUDIO_URL=http://host.docker.internal:1234/v1/chat/completions
LMSTUDIO_MODEL=gemma-4-e4b-it-uncensored

# ComfyUI (image-gen, ต้องมี GPU บน host) — ถ้าไม่ใช้รูปประกอบ ปล่อยไว้ได้
COMFYUI_URL=http://host.docker.internal:8188
