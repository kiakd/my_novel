# ============================================================
#  Novel backend (Bun/Elysia) — .env
#  คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า:  cp .env.example .env
#  (.env ถูก gitignore — secret ไม่หลุดขึ้น git)
# ============================================================

# ------------------------------------------------------------
#  MongoDB  (จำเป็น — ถ้าไม่ตั้ง server จะ throw ตอนบูต)
# ------------------------------------------------------------
# เลือกแบบใดแบบหนึ่ง:
#
#  ก) Local / Docker:
#     MONGODB_URI=mongodb://127.0.0.1:27017
#     (รัน Mongo เร็วๆ:  docker run -d --name novel-mongo -p 27017:27017 mongo)
#
#  ข) MongoDB Atlas (cloud):
#     MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
#     - <password> ที่มีอักขระพิเศษ (@ : / ?) ต้อง URL-encode
#     - เปิด Network Access ให้ IP เครื่องคุณ (หรือ 0.0.0.0/0 ชั่วคราว)
#
#  หมายเหตุ: ชื่อ DB มาจาก MONGODB_DB ด้านล่าง (path ใน URI ถูกมองข้าม)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=novel

# ------------------------------------------------------------
#  Server
# ------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------
#  AI text provider (สำหรับเจนนิยาย/รีวิว/สรุป)
# ------------------------------------------------------------
# เลือก provider เริ่มต้น: openrouter | deepseek
AI_PROVIDER=deepseek

# --- OpenRouter (aggregator หลายรุ่น) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=NovelR18

# --- DeepSeek direct (ถูกกว่า + cache hit ฟรี) — platform.deepseek.com ---
DEEPSEEK_API_KEY=
# deepseek-chat (V3.2) หรือ deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
#  App logging (request/activity/error) → collection app_logs + ไฟล์ JSONL
# ------------------------------------------------------------
LOG_DIR=./logs        # โฟลเดอร์ไฟล์ log รายวัน (app-YYYY-MM-DD.log)
LOG_TTL_DAYS=30       # อายุ log ใน MongoDB ก่อนหมดอายุอัตโนมัติ (TTL index)
# LOG_TO_FILE=0       # ตั้ง 0 เพื่อปิดการเขียนไฟล์
# LOG_TO_MONGO=0      # ตั้ง 0 เพื่อปิดการเขียน MongoDB
