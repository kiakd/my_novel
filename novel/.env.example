MONGODB_URI=
MONGODB_DB=novel
PORT=3000

# เลือก provider: openrouter | deepseek
AI_PROVIDER=deepseek

# --- OpenRouter (aggregator, หลายรุ่น) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=NovelR18

# --- DeepSeek direct (ถูกกว่า + cache hit ฟรี) ---
# สมัครที่ platform.deepseek.com
DEEPSEEK_API_KEY=
# deepseek-chat (V3.2) หรือ deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat

# --- Image Generation ---
# ดู docs/image-gen.md สำหรับวิธีขอ API key แต่ละเจ้า

# ComfyUI local (รัน: cd ~/dru/comfyui && ./start.sh)
COMFYUI_URL=http://127.0.0.1:8188

# NovelAI (novelai.net > Settings > Account > Get Persistent API Token)
NOVELAI_API_KEY=

# Tensor.art (tensor.art/tools/api > Create key)
TENSORART_API_KEY=

# Civitai (civitai.com > Account Settings > API Keys)
CIVITAI_API_KEY=
